"""Authorization checks for controlled enforcement demonstrations."""

import json
import os
from pathlib import Path

import psutil


PROJECT_ROOT = Path(__file__).resolve().parents[2]
AUTH_DIR = PROJECT_ROOT / "data" / "demo_authorization"

ALLOWED_SCRIPTS = {
    "benign.sh",
    "quarantine.sh",
    "ransomware_classification_demo.py",
    "test_creation_deletion.py",
}


def authorize_demo(script_name: str) -> dict:
    """Register the current process as an authorized demonstration."""
    if script_name not in ALLOWED_SCRIPTS:
        raise ValueError(f"Unauthorized demonstration: {script_name}")

    process = psutil.Process(os.getpid())

    AUTH_DIR.mkdir(parents=True, exist_ok=True)

    identity = {
        "pid": process.pid,
        "create_time": process.create_time(),
        "script": script_name,
    }

    path = AUTH_DIR / f"{process.pid}.json"
    path.write_text(json.dumps(identity), encoding="utf-8")

    return identity


def is_authorized_demo(pid: int | None) -> bool:
    """Verify a process against its registered PID and creation time."""
    if not isinstance(pid, int) or pid <= 1:
        return False

    path = AUTH_DIR / f"{pid}.json"

    try:
        identity = json.loads(path.read_text(encoding="utf-8"))
        process = psutil.Process(pid)

        return (
            identity.get("pid") == pid
            and (
                identity.get("script") in ALLOWED_SCRIPTS
                or identity.get("demo") in {
                    "benign",
                    "quarantine",
                    "ransomware",
                    "creation_deletion",
                }
            )
            and abs(
                process.create_time()
                - float(identity["create_time"])
            ) < 0.001
            and process.is_running()
        )

    except (
        OSError,
        ValueError,
        TypeError,
        KeyError,
        psutil.Error,
    ):
        return False
